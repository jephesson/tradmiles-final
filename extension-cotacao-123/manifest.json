{
  "manifest_version": 3,
  "name": "TradeMiles Cotação",
  "version": "1.8.10",
  "description": "Decolar à vista; nas milhas você seleciona o voo e a IA lê milhas e taxa.",
  "permissions": ["tabs", "windows", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://b2c.voegol.com.br/*",
    "https://www.voegol.com.br/*",
    "https://voegol.com.br/*",
    "https://www.latamairlines.com/*",
    "https://latamairlines.com/*",
    "https://www.voeazul.com.br/*",
    "https://voeazul.com.br/*",
    "https://www.decolar.com/*",
    "https://decolar.com/*",
    "https://www.smiles.com.br/*",
    "https://smiles.com.br/*",
    "https://www.trademiles.com.br/*",
    "https://trademiles.com.br/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.trademiles.com.br/dashboard/*",
        "https://trademiles.com.br/dashboard/*",
        "http://localhost:3000/dashboard/*"
      ],
      "js": ["content/trademiles-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.decolar.com/*", "https://decolar.com/*"],
      "js": ["content/decolar.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.latamairlines.com/*", "https://latamairlines.com/*"],
      "js": ["content/capture-miles.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.voeazul.com.br/*", "https://voeazul.com.br/*"],
      "js": ["content/capture-miles.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.smiles.com.br/*", "https://smiles.com.br/*"],
      "js": ["content/capture-miles.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TradeMiles Cotação",
    "default_popup": "popup.html"
  }
}
