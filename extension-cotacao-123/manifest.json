{
  "manifest_version": 3,
  "name": "TradeMiles Cotação 123milhas",
  "version": "1.2.1",
  "description": "Pesquisa o 123milhas em segundo plano (sem login) e devolve o menor Pix ao TradeMiles.",
  "permissions": ["tabs", "windows", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://123milhas.com/*",
    "https://www.123milhas.com/*",
    "https://www.trademiles.com.br/*",
    "https://trademiles.com.br/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.trademiles.com.br/dashboard/*",
        "https://trademiles.com.br/dashboard/*",
        "http://localhost:3000/dashboard/*"
      ],
      "js": ["content/trademiles-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://123milhas.com/*", "https://www.123milhas.com/*"],
      "js": ["content/123milhas.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TradeMiles Cotação",
    "default_popup": "popup.html"
  }
}
